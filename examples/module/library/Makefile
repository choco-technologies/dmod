DMOD_MODULE_VERSION=0.1
DMOD_AUTHOR_NAME=Patryk Kubiak
DMOD_CSOURCES=dmodex.c
DMOD_CXXSOURCES=
DMOD_INC_DIRS=.
DMOD_LIBS=
DMOD_DEFINITIONS=

# -----------------------------------------------------------------------------
#   Include the dmod lib makefile
# -----------------------------------------------------------------------------
include $(DMOD_DMF_LIB_FILE_PATH)