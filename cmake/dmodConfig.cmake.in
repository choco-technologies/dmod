@PACKAGE_INIT@

if(DEFINED DMOD_MODE AND NOT DMOD_MODE STREQUAL "DMOD_MODULE")
    set(dmod_FOUND FALSE)
    set(dmod_NOT_FOUND_MESSAGE "The installed DMOD SDK supports DMOD_MODULE builds only")
    return()
endif()
set(DMOD_MODE DMOD_MODULE)
set(DMOD_MODULE ON)
set(DMOD_SYSTEM OFF)
set_and_check(DMOD_DIR "@PACKAGE_DMOD_SDK_INSTALL_DIR@")
set_and_check(DMOD_INC_DIR "@PACKAGE_DMOD_SDK_INCLUDE_DIR@")
set(DMOD_SCRIPTS_DIR "${DMOD_DIR}/scripts")
set(DMOD_SRC_DIR "${DMOD_DIR}/src")
set(DMOD_TOOLS_BIN_DIR "${PACKAGE_PREFIX_DIR}/bin")
set(DMOD_MODULE_HEADER_SOURCE_IN_FILE_PATH "${DMOD_SCRIPTS_DIR}/dmod_header.c.in")
set(DMOD_VERSION_IN_FILE_PATH "${DMOD_SCRIPTS_DIR}/version.txt.in")
set(dmod_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(dmod_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(DMOD_BUILD_DIR "${CMAKE_BINARY_DIR}/dmod-sdk" CACHE PATH "DMOD runtime build directory")
set(DMOD_DMF_DIR "${CMAKE_BINARY_DIR}/dmf" CACHE PATH "DMF output directory")
set(DMOD_DMFC_DIR "${CMAKE_BINARY_DIR}/dmfc" CACHE PATH "Compressed DMF output directory")
set(DMOD_REPO_DIR "${DMOD_DMF_DIR}" CACHE PATH "Module installation directory")
set(DMOD_ARRAY_SEP ":")
set(DMOD_PATH_SEP "/")
set(DMOD_REPO_PATHS "${DMOD_DMF_DIR}:${DMOD_DMFC_DIR}" CACHE STRING "Module search paths")
include("${DMOD_DIR}/dmod-defaults.cmake")
include("${DMOD_SCRIPTS_DIR}/CMakeLists.txt")

# These programs run on the build host, including when the module is compiled
# with a cross toolchain whose program search is rooted in a target sysroot.
find_program(TODMFC todmfc HINTS "${DMOD_TOOLS_BIN_DIR}" NO_CMAKE_FIND_ROOT_PATH REQUIRED)
find_program(TODMD todmd HINTS "${DMOD_TOOLS_BIN_DIR}" NO_CMAKE_FIND_ROOT_PATH REQUIRED)
find_program(TODMM todmm HINTS "${DMOD_TOOLS_BIN_DIR}" NO_CMAKE_FIND_ROOT_PATH REQUIRED)
find_program(MKDMRPKG mkdmrpkg HINTS "${DMOD_TOOLS_BIN_DIR}" NO_CMAKE_FIND_ROOT_PATH REQUIRED)
find_program(DMF_GET dmf-get HINTS "${DMOD_TOOLS_BIN_DIR}" NO_CMAKE_FIND_ROOT_PATH REQUIRED)

if(NOT TARGET dmod)
    add_subdirectory("${DMOD_DIR}/cmake/runtime" "${DMOD_BUILD_DIR}")
endif()
check_required_components(dmod)
