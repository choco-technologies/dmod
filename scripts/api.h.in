#ifndef DMOD_MOD_DEFS_H_@DMOD_MODULE_NAME@
#define DMOD_MOD_DEFS_H_@DMOD_MODULE_NAME@

#include "dmod_defs.h"


#ifdef DMOD_@DMOD_MODULE_NAME@
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_api_to_mal(MODULE,NAME)                            \
            DMOD_API_TO_MAL(@DMOD_MODULE_NAME@, MODULE, NAME)
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_api_to_mal_ex(NAME_IN, MODULE_MAL, NAME_MAL)       \
            DMOD_API_TO_MAL_EX(@DMOD_MODULE_NAME@, MODULE_IN, NAME_IN, MODULE_MAL, NAME_MAL)
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_api(VERSION, RET, NAME, PARAMS)                    \
            DMOD_INPUT_API(@DMOD_MODULE_NAME@, VERSION, RET, NAME, PARAMS)
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_global_api(VERSION, RET, NAME, PARAMS)             \
            DMOD_GLOBAL_INPUT_API(@DMOD_MODULE_NAME@, VERSION, RET, NAME, PARAMS)
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_mal(VERSION, RET, NAME, PARAMS)                    \
            DMOD_MAL_OUTPUT_API(@DMOD_MODULE_NAME@ , VERSION, RET, NAME, PARAMS)
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_global_mal(VERSION, RET, NAME, PARAMS)             \
            DMOD_GLOBAL_MAL_OUTPUT_API(@DMOD_MODULE_NAME@, VERSION, RET, NAME, PARAMS)
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_api_declaration(VERSION, RET, NAME, PARAMS)        \
            DMOD_INPUT_API_DECLARATION(@DMOD_MODULE_NAME@, VERSION, RET, NAME, PARAMS)
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_dif(VERSION, RET, NAME, PARAMS)                    \
    typedef RET (*dmod_@DMOD_MODULE_NAME_SNAKE_CASE@##NAME##_t) PARAMS; \
    extern const char* const DMOD_MAKE_DIF_SIG_NAME(@DMOD_MODULE_NAME_SNAKE_CASE@, NAME);
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_dif_api_declaration(VERSION, IMPL_MODULE, RET, NAME, PARAMS)  \
            DMOD_DIF_API_DECLARATION(@DMOD_MODULE_NAME@, IMPL_MODULE, VERSION, RET, NAME, PARAMS)
#   define DMOD_MODULE_NAME        "@DMOD_MODULE_NAME@"
#   define DMOD_MODULE_VERSION     "@DMOD_MODULE_VERSION@"
#   define DMOD_AUTHOR_NAME        "@DMOD_AUTHOR_NAME@"
#   define DMOD_STACK_SIZE         @DMOD_STACK_SIZE@
#   define DMOD_PRIORITY           @DMOD_PRIORITY@
#   define DMOD_MODULE_TYPE        Dmod_ModuleType_@DMOD_MODULE_TYPE@
#   define DMOD_MANUAL_LOAD        @DMOD_MANUAL_LOAD@
#else
#  ifdef DMOD_MAL_@DMOD_MODULE_NAME@
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_mal(VERSION, RET, NAME, PARAMS)            \
                DMOD_MAL_INPUT_API(@DMOD_MODULE_NAME@, VERSION, RET, NAME, PARAMS)
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_global_mal(VERSION, RET, NAME, PARAMS)     \
                DMOD_GLOBAL_MAL_INPUT_API(@DMOD_MODULE_NAME@, VERSION, RET, NAME, PARAMS)
#else 
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_mal(VERSION, RET, NAME, PARAMS)            \
                DMOD_MAL_OUTPUT_API(@DMOD_MODULE_NAME@ , VERSION, RET, NAME, PARAMS)
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_global_mal(VERSION, RET, NAME, PARAMS)     \
                DMOD_GLOBAL_MAL_OUTPUT_API(@DMOD_MODULE_NAME@, VERSION, RET, NAME, PARAMS)
#endif
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_api(VERSION, RET, NAME, PARAMS)            \
                DMOD_OUTPUT_API(@DMOD_MODULE_NAME@, VERSION, RET, NAME, PARAMS)
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_global_api(VERSION, RET, NAME, PARAMS)     \
                DMOD_GLOBAL_OUTPUT_API(@DMOD_MODULE_NAME@, VERSION, RET, NAME, PARAMS)
# ifdef ENABLE_DIF_REGISTRATIONS
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_dif(VERSION, RET, NAME, PARAMS)            \
                typedef RET (*dmod_@DMOD_MODULE_NAME_SNAKE_CASE@##NAME##_t) PARAMS; \
                const char* const DMOD_MAKE_DIF_SIG_NAME(@DMOD_MODULE_NAME_SNAKE_CASE@, NAME) = DMOD_MAKE_DIF_SIGNATURE(@DMOD_MODULE_NAME@, VERSION, NAME);
#  else
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_dif(VERSION, RET, NAME, PARAMS)            \
                typedef RET (*dmod_@DMOD_MODULE_NAME_SNAKE_CASE@##NAME##_t) PARAMS; \
                _DMOD_DIF_SIGNATURE_REGISTRATION(DMOD_MAKE_DIF_SIG_NAME(@DMOD_MODULE_NAME_SNAKE_CASE@, NAME), DMOD_MAKE_DIF_SIGNATURE(@DMOD_MODULE_NAME@, VERSION, NAME))
#  endif
#  define dmod_@DMOD_MODULE_NAME_SNAKE_CASE@_dif_api_declaration(VERSION, IMPL_MODULE, RET, NAME, PARAMS)  \
                RET DMOD_MAKE_DIF_API_FUNCTION_NAME(@DMOD_MODULE_NAME@, IMPL_MODULE, NAME) PARAMS; \
                _DMOD_DIF_API_REGISTRATION(@DMOD_MODULE_NAME@, IMPL_MODULE, VERSION, NAME) \
                RET DMOD_MAKE_DIF_API_FUNCTION_NAME(@DMOD_MODULE_NAME@, IMPL_MODULE, NAME) PARAMS
#endif

#endif // DMOD_MOD_DEFS_H_@DMOD_MODULE_NAME@