DMOD_DIR = @DMOD_PROJECT_DIR@

#
#  Name of the module
#
DMOD_LIB_NAME=lib@DMOD_LIB_NAME@.a
DMOD_SOURCES=@DMOD_SOURCES@
DMOD_INC_DIRS = @DMOD_INC_DIRS@
DMOD_LIBS = @DMOD_LIBS@
DMOD_GEN_HEADERS_IN = @DMOD_GEN_HEADERS_IN@
DMOD_MODE = @DMOD_MODE@
DMOD_SYSTEM = @DMOD_SYSTEM@
DMOD_MODULE = @DMOD_MODULE@

# -----------------------------------------------------------------------------
# 	Initialization of paths
# -----------------------------------------------------------------------------
include $(DMOD_DIR)/paths.mk

# -----------------------------------------------------------------------------
# 	Including the template for the library
# -----------------------------------------------------------------------------
DMOD_LIB_OBJS_DIR = $(DMOD_OBJS_DIR)/@DMOD_LIB_NAME@
include $(DMOD_SLIB_FILE_PATH)