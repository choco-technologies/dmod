# Generates the table of the relocations of a module (DMOD_USE_RELDYN, see docs/reldyn.md)
#
# Run as a script: cmake -DELF=<linked module without the table> -DREADELF=<readelf of the toolchain> -DOUT=<C file> -P reldyn.cmake
#
# The ELF was linked with -Wl,-q, so it keeps the relocations of the words that hold an address. The table is the offsets of
# those words in the module, in ascending order, 32 bits each - what the loader adds the address of the load to. It leaves out
# the words in .header, .inputs and .outputs: the loader relocates them itself.
cmake_minimum_required(VERSION 3.18)

foreach(var ELF READELF OUT)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "reldyn.cmake: ${var} is not defined")
    endif()
endforeach()

execute_process(
    COMMAND ${READELF} -r -W ${ELF}
    OUTPUT_VARIABLE RELOCATIONS
    RESULT_VARIABLE RESULT
)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "reldyn.cmake: ${READELF} failed on ${ELF}")
endif()

string(REPLACE "\n" ";" LINES "${RELOCATIONS}")
set(SECTION "")
set(OFFSETS "")
foreach(LINE IN LISTS LINES)
    if(LINE MATCHES "^Relocation section '([^']+)'")
        set(SECTION "${CMAKE_MATCH_1}")
    elseif(LINE MATCHES "^([0-9a-f]+)[ ]+[0-9a-f]+[ ]+(R_[A-Z0-9_]+)")
        set(OFFSET "${CMAKE_MATCH_1}")
        set(TYPE "${CMAKE_MATCH_2}")
        # the words that the loader relocates itself, and the relocations of what is not loaded (debug, properties)
        if(SECTION MATCHES "^\\.rela\\.(header|inputs|outputs|got|xt\\.|debug|comment|note)")
            continue()
        endif()
        # an address in a word (a literal, a pointer in the data); the others are relative to the place or need no relocation
        if(TYPE STREQUAL "R_XTENSA_32" OR TYPE STREQUAL "R_XTENSA_PLT")
            list(APPEND OFFSETS "${OFFSET}")
        endif()
    endif()
endforeach()

# 8 hex digits each: the order of the strings is the order of the numbers
list(REMOVE_DUPLICATES OFFSETS)
list(SORT OFFSETS)

set(BODY "")
set(COUNT 0)
foreach(OFFSET IN LISTS OFFSETS)
    string(APPEND BODY "    0x${OFFSET}u,\n")
    math(EXPR COUNT "${COUNT} + 1")
endforeach()

# The section .got can have the entries of the GOT that the linker made (the addresses of what the code takes through the GOT)
# before or after this table: it starts with the magic (1: it must pass for an offset in the module on the host) and the number of the
# offsets, so that the loader finds it
math(EXPR TABLE_WORDS "${COUNT} + 2")
set(CONTENT "/* Generated by reldyn.cmake - the table of the relocations of the module (${COUNT} words), do not edit */\n#include <stdint.h>\n\n")
string(APPEND CONTENT "const uint32_t dmod_reldyn[${TABLE_WORDS}] __attribute__((section(\".got\"), used, aligned(4))) =\n{\n    1u, ${COUNT}u,\n${BODY}};\n")

# do not touch the file when nothing changed: the module is not linked again for nothing
set(OLD "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" OLD)
endif()
if(NOT OLD STREQUAL CONTENT)
    file(WRITE "${OUT}" "${CONTENT}")
endif()
message(STATUS "reldyn: ${COUNT} relocations")
