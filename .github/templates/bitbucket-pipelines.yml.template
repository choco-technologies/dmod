image: chocotechnologies/dmod:1.0.1

pipelines:
  default:
    - step:
        name: Build with CMake
        script:
          - mkdir -p build
          - cd build
          - cmake .. -DDMOD_MODE=DMOD_MODULE
          - cmake --build .
    
    - step:
        name: Build with Make
        script:
          - make clean
          - make DMOD_MODE=DMOD_MODULE
