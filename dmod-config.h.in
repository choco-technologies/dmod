#ifndef DMOD_CONFIG_H
#define DMOD_CONFIG_H

#define dmod_VERSION_MAJOR @dmod_VERSION_MAJOR@
#define dmod_VERSION_MINOR @dmod_VERSION_MINOR@
#define DMOD_VERSION_STRING "@dmod_VERSION_MAJOR@.@dmod_VERSION_MINOR@"
#define DMOD_VERSION        ((uint32_t)((@dmod_VERSION_MAJOR@ << 8) | (@dmod_VERSION_MINOR@)))
#define DMOD_MAX_MODULES                @DMOD_MAX_MODULES@
#define DMOD_MAX_REQUIRED_MODULES       @DMOD_MAX_REQUIRED_MODULES@
#define DMOD_USE_STDLIB                 @DMOD_USE_STDLIB@
#define DMOD_USE_STDIO                  @DMOD_USE_STDIO@
#define DMOD_USE_ASSERT                 @DMOD_USE_ASSERT@
#define DMOD_USE_PTHREAD                @DMOD_USE_PTHREAD@
#define DMOD_USE_MMAN                   @DMOD_USE_MMAN@
#define DMOD_USE_ALIGNED_ALLOC          @DMOD_USE_ALIGNED_ALLOC@
#define DMOD_USE_ALIGNED_MALLOC_MOCK    @DMOD_USE_ALIGNED_MALLOC_MOCK@
#define DMOD_USE_FASTLZ                 @DMOD_USE_FASTLZ@
#define DMOD_MODE           "@DMOD_MODE@"
#define DMOD_SYSTEM_EN      @DMOD_SYSTEM@
#define DMOD_MODULE_EN      @DMOD_MODULE@
#define DMOD_SYSTEM_VERSION_MAJOR @DMOD_SYSTEM_VERSION_MAJOR@
#define DMOD_SYSTEM_VERSION_MINOR @DMOD_SYSTEM_VERSION_MINOR@
#define DMOD_SYSTEM_VERSION_STRING "@DMOD_SYSTEM_VERSION_MAJOR@.@DMOD_SYSTEM_VERSION_MINOR@"
#define DMOD_SYSTEM_VERSION ((uint32_t)((@DMOD_SYSTEM_VERSION_MAJOR@ << 8) | (@DMOD_SYSTEM_VERSION_MINOR@)))
#define DMOD_REPO_DIR        "@DMOD_REPO_DIR@"
#define DMOD_CPU_NAME        "@DMOD_CPU_NAME@"

#ifndef ON 
#   define ON 1
#endif

#ifndef OFF
#   define OFF 0
#endif

#endif // DMOD_CONFIG_H
