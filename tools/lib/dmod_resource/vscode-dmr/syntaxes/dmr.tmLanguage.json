{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DMOD Resource",
  "scopeName": "source.dmr",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#resource-entry"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.dmr",
          "match": "#.*$"
        }
      ]
    },
    "resource-entry": {
      "patterns": [
        {
          "name": "meta.resource-entry.dmr",
          "match": "^\\s*([a-zA-Z0-9_.-]+)\\s*=\\s*(.+?)\\s*=>\\s*([^\\[]+?)((?:\\s*\\[origin=[^\\]]*\\])*)?$",
          "captures": {
            "1": {
              "name": "entity.name.function.resource-key.dmr"
            },
            "2": {
              "name": "string.unquoted.source-path.dmr",
              "patterns": [
                {
                  "include": "#path-content"
                }
              ]
            },
            "3": {
              "name": "string.unquoted.destination-path.dmr",
              "patterns": [
                {
                  "include": "#path-content"
                }
              ]
            },
            "4": {
              "name": "meta.origin-directives.dmr",
              "patterns": [
                {
                  "include": "#origin-directive"
                }
              ]
            }
          }
        }
      ]
    },
    "origin-directive": {
      "patterns": [
        {
          "name": "meta.origin.dmr",
          "match": "\\[origin=([^\\]]*)\\]",
          "captures": {
            "0": {
              "name": "keyword.other.origin-directive.dmr"
            },
            "1": {
              "name": "string.unquoted.origin-path.dmr",
              "patterns": [
                {
                  "include": "#path-content"
                }
              ]
            }
          }
        }
      ]
    },
    "path-content": {
      "patterns": [
        {
          "name": "variable.other.placeholder.dmr",
          "match": "\\$\\{([a-zA-Z0-9_]+)\\}",
          "captures": {
            "1": {
              "name": "variable.parameter.dmr"
            }
          }
        },
        {
          "name": "string.other.path.dmr",
          "match": "[^\\s$\\[\\]]+"
        }
      ]
    }
  }
}
