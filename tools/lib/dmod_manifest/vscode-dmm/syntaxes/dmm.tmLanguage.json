{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DMOD Manifest",
  "scopeName": "source.dmm",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#dmod-version-directive"
    },
    {
      "include": "#version-available-directive"
    },
    {
      "include": "#include-directive"
    },
    {
      "include": "#module-entry"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.dmm",
          "match": "#.*$"
        }
      ]
    },
    "dmod-version-directive": {
      "patterns": [
        {
          "name": "meta.dmod-version.dmm",
          "match": "^\\s*(\\$dmod-version)\\s+([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)\\s*$",
          "captures": {
            "1": {
              "name": "keyword.control.dmod-version.dmm"
            },
            "2": {
              "name": "constant.numeric.version.dmm"
            }
          }
        }
      ]
    },
    "version-available-directive": {
      "patterns": [
        {
          "name": "meta.version-available.dmm",
          "match": "^\\s*(\\$version-available)\\s+([a-zA-Z0-9_.-]+)\\s+(.+)$",
          "captures": {
            "1": {
              "name": "keyword.control.version-available.dmm"
            },
            "2": {
              "name": "entity.name.function.module.dmm"
            },
            "3": {
              "name": "meta.version-list.dmm",
              "patterns": [
                {
                  "name": "constant.numeric.version.dmm",
                  "match": "[0-9a-zA-Z._-]+"
                }
              ]
            }
          }
        }
      ]
    },
    "include-directive": {
      "patterns": [
        {
          "name": "meta.include.dmm",
          "match": "^\\s*(\\$include)\\s+(.+)$",
          "captures": {
            "1": {
              "name": "keyword.control.include.dmm"
            },
            "2": {
              "name": "string.unquoted.url.dmm",
              "patterns": [
                {
                  "include": "#url-content"
                }
              ]
            }
          }
        }
      ]
    },
    "module-entry": {
      "patterns": [
        {
          "name": "meta.module-entry.dmm",
          "match": "^\\s*([a-zA-Z0-9_.-]+)(@([0-9a-zA-Z._-]+))?\\s+(.+)$",
          "captures": {
            "1": {
              "name": "entity.name.function.module.dmm"
            },
            "2": {
              "name": "meta.version.dmm"
            },
            "3": {
              "name": "constant.numeric.version.dmm"
            },
            "4": {
              "name": "string.unquoted.url.dmm",
              "patterns": [
                {
                  "include": "#url-content"
                }
              ]
            }
          }
        }
      ]
    },
    "url-content": {
      "patterns": [
        {
          "name": "variable.other.placeholder.dmm",
          "match": "<(tools_name|arch_name|version)>",
          "captures": {
            "1": {
              "name": "variable.parameter.dmm"
            }
          }
        },
        {
          "name": "string.other.url.dmm",
          "match": "(https?|file)://[^\\s<>]+"
        }
      ]
    }
  }
}
