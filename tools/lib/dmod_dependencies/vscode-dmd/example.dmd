# Example DMOD Dependencies File
# This file demonstrates the .dmd format

# Simple module entries without versions
dmell
dmffs
dmramfs
driver
make_dmffs

# Module entries with specific versions
dmdevfs@0.2
spi@1.0
i2c@2.5
uart@1.2.3

# Module entries with configuration files
# Format: module[@version] config_path [custom_dest_name]
dmclk board/stm32f746g-disco.ini
dmclk@1.0 mcu/stm32f7.ini
uart@1.2.3 configs/uart_115200.ini

# Module with configuration but no version
gpio configs/gpio_default.cfg

# Module with custom destination filename
# This will create clk.ini directly in config dir (without dmclk/ subdirectory)
dmclk@1.0 mcu/stm32f7.ini clk.ini

# Module entries with a tagged configuration file
# Format: module[@version] [<tag>=]config_path [custom_dest_name]
# Use with: dmf-get -d deps.dmd --config-map "driver:./config/drivers;service:./config/services"
# Configs tagged "driver" are copied to ./config/drivers, "service" ones to ./config/services
mymodule driver=board/stm32f746g-disco.ini
anothermodule service=generic/service.ini

# A tag can be combined with a custom destination filename
dmclk@1.0 driver=mcu/stm32f7.ini clk.ini

# Variable substitution in configuration paths
# Use with: dmf-get -d deps.dmd --config-dir ./config -D BOARD=stm32f7
dmclk@1.0 boards/${BOARD}/config.ini
uart@2.0 boards/${BOARD}/uart.ini ${BOARD}_uart.ini

# Multiple entries for same driver with different config versions
# Use driver from 1.0, but copy configs from different versions
dmclk@1.0
dmclk@0.1 mcu/stm32f7.ini
dmclk@0.2 mcu/high-speed.ini

# Module entries with version ranges
dmffs_extended@>=1.0        # Version 1.0 or newer
old_driver@<=2.0            # Version 2.0 or older
can_driver@>=1.0<=2.0       # Version between 1.0 and 2.0

# Include another dependencies file
$include https://raw.githubusercontent.com/example/deps.dmd

# Change the manifest source for following modules
$from https://registry.example.com/manifest.dmm

# These modules will be downloaded from the new manifest
flash_driver@3.0
eeprom_driver@1.1

# You can change the manifest multiple times
$from https://another-registry.com/manifest.dmm

# More modules with the new manifest
sensor_lib@2.0
display_lib@4.5

# Inline $from directive for a single module
crypto_module@2.1 $from https://security-registry.com/manifest.dmm

# Module with configuration and inline $from
adc@1.5 config/adc_12bit.ini $from https://custom-registry.com/manifest.dmm

# Configuration with custom name and inline $from
dac@2.0 config/dac_default.ini my_dac.ini $from https://hw-registry.com/manifest.dmm
