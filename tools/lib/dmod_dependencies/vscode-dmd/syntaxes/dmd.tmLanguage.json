{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DMOD Dependencies",
  "scopeName": "source.dmd",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#include-directive"
    },
    {
      "include": "#from-directive"
    },
    {
      "include": "#module-entry"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.dmd",
          "match": "#.*$"
        }
      ]
    },
    "include-directive": {
      "patterns": [
        {
          "name": "meta.include.dmd",
          "match": "^\\s*(\\$include)\\s+(.+)$",
          "captures": {
            "1": {
              "name": "keyword.control.include.dmd"
            },
            "2": {
              "name": "string.unquoted.url.dmd"
            }
          }
        }
      ]
    },
    "from-directive": {
      "patterns": [
        {
          "name": "meta.from.dmd",
          "match": "^\\s*(\\$from)\\s+(.+)$",
          "captures": {
            "1": {
              "name": "keyword.control.from.dmd"
            },
            "2": {
              "name": "string.unquoted.url.dmd"
            }
          }
        }
      ]
    },
    "inline-from": {
      "patterns": [
        {
          "name": "meta.inline-from.dmd",
          "match": "(\\$from)\\s+(.+)$",
          "captures": {
            "1": {
              "name": "keyword.control.from.dmd"
            },
            "2": {
              "name": "string.unquoted.url.dmd"
            }
          }
        }
      ]
    },
    "module-entry": {
      "patterns": [
        {
          "name": "meta.module-entry.dmd",
          "begin": "^\\s*([a-zA-Z0-9_.-]+)(@([><=]+)?([0-9a-zA-Z._-]+)([><=]+[0-9a-zA-Z._-]+)?)?(?=\\s|$)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.module.dmd"
            },
            "2": {
              "name": "meta.version.dmd"
            },
            "3": {
              "name": "keyword.operator.comparison.dmd"
            },
            "4": {
              "name": "constant.numeric.version.dmd"
            },
            "5": {
              "name": "meta.version-range.dmd",
              "patterns": [
                {
                  "match": "([><=]+)([0-9a-zA-Z._-]+)",
                  "captures": {
                    "1": {
                      "name": "keyword.operator.comparison.dmd"
                    },
                    "2": {
                      "name": "constant.numeric.version.dmd"
                    }
                  }
                }
              ]
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "match": "(@screen)\\s+([1-9][0-9]*x[1-9][0-9]*)\\b",
              "captures": {
                "1": {
                  "name": "keyword.other.screen.dmd"
                },
                "2": {
                  "name": "constant.numeric.screen.dmd"
                }
              }
            },
            {
              "include": "#inline-from"
            },
            {
              "match": "([^\\s]+)",
              "name": "string.unquoted.config-path.dmd"
            }
          ]
        }
      ]
    }
  }
}
