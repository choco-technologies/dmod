{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DMOD Dependencies",
  "scopeName": "source.dmd",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#include-directive"
    },
    {
      "include": "#from-directive"
    },
    {
      "include": "#module-entry"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.dmd",
          "match": "#.*$"
        }
      ]
    },
    "include-directive": {
      "patterns": [
        {
          "name": "meta.include.dmd",
          "match": "^\\s*(\\$include)\\s+(.+)$",
          "captures": {
            "1": {
              "name": "keyword.control.include.dmd"
            },
            "2": {
              "name": "string.unquoted.url.dmd"
            }
          }
        }
      ]
    },
    "from-directive": {
      "patterns": [
        {
          "name": "meta.from.dmd",
          "match": "^\\s*(\\$from)\\s+(.+)$",
          "captures": {
            "1": {
              "name": "keyword.control.from.dmd"
            },
            "2": {
              "name": "string.unquoted.url.dmd"
            }
          }
        }
      ]
    },
    "inline-from": {
      "patterns": [
        {
          "name": "meta.inline-from.dmd",
          "match": "(\\$from)\\s+(.+)$",
          "captures": {
            "1": {
              "name": "keyword.control.from.dmd"
            },
            "2": {
              "name": "string.unquoted.url.dmd"
            }
          }
        }
      ]
    },
    "module-entry": {
      "patterns": [
        {
          "name": "meta.module-entry.dmd",
          "match": "^\\s*([a-zA-Z0-9_.-]+)(@([><=]+)?([0-9a-zA-Z._-]+)([><=]+[0-9a-zA-Z._-]+)?)?(?:\\s+((?:[^\\s$]+|\\$(?!from))+))?(?:\\s+((?:[^\\s$]+|\\$(?!from))+))?\\s*(\\$from\\s+.+)?$",
          "captures": {
            "1": {
              "name": "entity.name.function.module.dmd"
            },
            "2": {
              "name": "meta.version.dmd"
            },
            "3": {
              "name": "keyword.operator.comparison.dmd"
            },
            "4": {
              "name": "constant.numeric.version.dmd"
            },
            "5": {
              "name": "meta.version-range.dmd",
              "patterns": [
                {
                  "match": "([><=]+)([0-9a-zA-Z._-]+)",
                  "captures": {
                    "1": {
                      "name": "keyword.operator.comparison.dmd"
                    },
                    "2": {
                      "name": "constant.numeric.version.dmd"
                    }
                  }
                }
              ]
            },
            "6": {
              "name": "string.unquoted.path.config.dmd"
            },
            "7": {
              "name": "string.unquoted.path.custom-name.dmd"
            },
            "8": {
              "patterns": [
                {
                  "include": "#inline-from"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
